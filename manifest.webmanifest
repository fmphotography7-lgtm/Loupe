{
  "name": "Loupe — frame check",
  "short_name": "Loupe",
  "description": "Check exposure, focus and composition on a photograph. Everything is measured on your own device.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0E0F11",
  "theme_color": "#0E0F11",
  "categories": ["photo", "productivity", "utilities"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "photos", "accept": ["image/jpeg", "image/png", "image/heic", "image/heif"] }
      ]
    }
  }
}
